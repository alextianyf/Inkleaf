{
  "name": "inkleaf-desktop",
  "productName": "Inkleaf",
  "version": "0.5.1",
  "description": "A quiet, local Markdown to PDF companion",
  "author": "Alex Tian",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "build:ui": "vite build",
    "lint": "eslint src",
    "format": "prettier --write src tests resources *.mjs *.json docs README.md",
    "pack": "npm run build:ui && electron-builder --dir --publish never",
    "dist:win": "npm run build:ui && electron-builder --win nsis --publish never",
    "test": "node --test tests/unit/*.test.cjs",
    "test:desktop": "node tests/integration/smoke.cjs",
    "test:position": "node tests/integration/window-position.cjs",
    "test:batch": "node tests/integration/batch-smoke.cjs",
    "test:layout": "node tests/integration/html-layout-smoke.cjs",
    "test:links": "node tests/integration/links-smoke.cjs",
    "test:compat": "node tests/integration/compatibility-smoke.cjs",
    "test:diagnostics": "node tests/integration/diagnostics-smoke.cjs",
    "test:engine": "npm test && npm run test:layout && npm run test:links && npm run test:headings && npm run test:compat && npm run test:diagnostics && npm run test:math",
    "test:math": "node tests/integration/math-delimiters-smoke.cjs",
    "test:all": "npm run lint && npm run build:ui && npm run test:engine && npm run test:desktop && npm run test:position && npm run test:batch && npm run test:updates && npm run test:settings && npm run test:navigation && npm run test:advanced && npm run test:layout-feedback && npm run test:runtime && npm run test:appearance",
    "benchmark": "node tests/performance/search.cjs",
    "test:updates": "node tests/integration/updates-smoke.cjs",
    "test:installed-update": "npm run build:ui && node tests/integration/installed-update.cjs",
    "test:settings": "node tests/integration/settings-smoke.cjs",
    "test:navigation": "node tests/integration/navigation-smoke.cjs",
    "test:advanced": "node tests/integration/advanced-layout-smoke.cjs",
    "test:layout-feedback": "node tests/integration/layout-feedback.cjs",
    "dev": "npm run build:ui && electron .",
    "test:runtime": "node tests/integration/runtime-smoke.cjs",
    "test:appearance": "node tests/integration/appearance-smoke.cjs",
    "test:headings": "node tests/integration/heading-pagination-smoke.cjs"
  },
  "build": {
    "appId": "com.alextian.aldus",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*.cjs",
      "src/search/**/*.cjs",
      "src/conversion/**/*.cjs",
      "src/shared/*.json",
      "resources/themes/*.css",
      "dist/renderer/**/*",
      "package.json",
      "LICENSE",
      "resources/styles/*.css",
      "resources/samples/**/*",
      "resources/icons/*.png",
      "resources/icons/*.ico"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Inkleaf-Setup-${version}.${ext}",
      "signExecutable": false,
      "icon": "resources/icons/inkleaf.ico"
    },
    "nsis": {
      "license": "LICENSE",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "resources/icons/inkleaf.icns"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "resources/icons/inkleaf-512.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alextianyf",
        "repo": "Inkleaf",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "3.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^8.0.1"
  }
}
